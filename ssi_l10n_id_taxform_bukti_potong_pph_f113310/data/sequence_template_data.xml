<odoo noupdate="1">
<!-- f113310 In -->
<record id="sequence_template_f113310_in" model="sequence.template">
    <field name="name">Standard Bukti Potong F113310 In</field>
    <field
            name="model_id"
            ref="ssi_l10n_id_taxform_bukti_potong_pph_f113310.model_l10n_id_bukti_potong_pph_f113310_in"
        />
    <field name="sequence" eval="100" />
    <field name="initial_string">/</field>
    <field
            name="sequence_field_id"
            search="[('model_id.model','=','l10n_id.bukti_potong_pph_f113310_in'),('name','=','name')]"
        />
    <field
            name="date_field_id"
            search="[('model_id.model','=','l10n_id.bukti_potong_pph_f113310_in'),('name','=','date')]"
        />
    <field name="computation_method">use_python</field>
    <field name="python_code">result=True</field>
    <field name="sequence_id" ref="sequence_f113310_in" />
    <field name="sequence_selection_method">use_sequence</field>
    <field name="add_custom_prefix" eval="0" />
    <field name="add_custom_suffix" eval="0" />
</record>

