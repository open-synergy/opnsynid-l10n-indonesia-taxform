<odoo>
    <template id="bpmp">
        <MmPayrollBulk xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <TIN t-esc="company_tin" />
            <ListOfMmPayroll>
                <t t-foreach="slips" t-as="slip">
                    <MmPayroll>
                        <TaxPeriodMonth t-esc="slip['tax_period_month']" />
                        <TaxPeriodYear t-esc="slip['tax_period_year']" />
                        <CounterpartOpt t-esc="slip['counterpart_opt']" />
                        <CounterpartPassport xsi:nil="true" />
                        <CounterpartTin t-esc="slip['counterpart_tin']" />
                        <StatusTaxExemption t-esc="slip['status_tax_exemption']" />
                        <Position t-esc="slip['position']" />
                        <TaxCertificate t-esc="slip['tax_certificate']" />
                        <TaxObjectCode t-esc="slip['tax_object_code']" />
                        <Gross t-esc="slip['gross']" />
                        <Rate t-esc="slip['rate']" />
                        <IDPlaceOfBusinessActivity
                            t-esc="slip['id_place_of_business_activity']"
                        />
                        <WithholdingDate t-esc="slip['withholding_date']" />
                    </MmPayroll>
                </t>
            </ListOfMmPayroll>
        </MmPayrollBulk>
    </template>
</odoo>
