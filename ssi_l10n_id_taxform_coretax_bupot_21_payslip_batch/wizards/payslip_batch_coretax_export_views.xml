<odoo>
    <record id="payslip_batch_coretax_export_view_form" model="ir.ui.view">
        <field name="name">hr.payslip_batch_coretax_export form</field>
        <field name="model">hr.payslip_batch_coretax_export</field>
        <field name="arch" type="xml">
            <form string="Export Coretax PPh 21 Withholding XML">
                <group>
                    <field name="batch_id" invisible="1" />
                    <field name="bruto_rule_id" />
                    <field name="pph_rule_id" />
                </group>
                <div>
                    <p>
                        Generate the Coretax BPMP XML (Bukti Pemotongan PPh 21
                        Pegawai Tetap) for every payslip in this batch whose
                        withheld PPh 21 is greater than zero.
                    </p>
                </div>
                <footer>
                    <button
                        name="action_export"
                        string="Export"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Discard" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="payslip_batch_coretax_export_action" model="ir.actions.act_window">
        <field name="name">Export Coretax PPh 21 XML</field>
        <field name="res_model">hr.payslip_batch_coretax_export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
