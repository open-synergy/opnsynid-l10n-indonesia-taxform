<odoo>
    <record id="bukti_potong_pph_f113301_out_view_form_coretax" model="ir.ui.view">
        <field name="name">
            l10n_id.bukti_potong_pph_f113301_out.coretax - form
        </field>
        <field name="model">l10n_id.bukti_potong_pph_f113301_out</field>
        <field
            name="inherit_id"
            ref="ssi_l10n_id_taxform_bukti_potong_pph_f113301.bukti_potong_pph_f113301_out_view_form"
        />
        <field name="arch" type="xml">
            <data>
                <!-- Superseded by the Print > Coretax XML report action
                     (reports/coretax_bupot_pph_f113301_out_report.xml),
                     which reuses the same _prepare_coretax_bupot_pph_out_values.
                     Hidden here only; other bukti potong types keep the
                     button from ssi_l10n_id_taxform_coretax_bupot_pph_out. -->
                <xpath
                    expr="//button[@name='action_export_coretax_bupot_pph_out_xml']"
                    position="attributes"
                >
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='wajib_pajak_id']" position="after">
                    <field name="id_tku_penerima" />
                </xpath>
                <xpath expr="//field[@name='pemotong_pajak_id']" position="after">
                    <field name="id_tku_pemotong" />
                </xpath>
                <xpath expr="//group[@name='header_right']" position="inside">
                    <field name="ptkp_category_id" />
                    <field name="withholding_date" />
                </xpath>
                <xpath
                    expr="//field[@name='line_ids']//tree/field[@name='amount_tax']"
                    position="after"
                >
                    <field name="fasilitas_pajak_id" optional="hide" />
                    <field name="dpp" optional="hide" />
                    <field name="rate" optional="hide" />
                </xpath>
                <xpath
                    expr="//field[@name='line_ids']//form//group[@name='grp_main']"
                    position="after"
                >
                    <group name="grp_coretax" string="Coretax" colspan="4" col="2">
                        <group name="grp_coretax_1" colspan="1" col="2">
                            <field name="fasilitas_pajak_id" />
                            <field name="reference_document_type_id" />
                            <field name="reference_document_number" />
                            <field name="reference_document_date" />
                        </group>
                        <group name="grp_coretax_2" colspan="1" col="2">
                            <field name="dpp" readonly="1" />
                            <field name="rate_computation_method" />
                            <field
                                name="manual_rate"
                                attrs="{'invisible': [('rate_computation_method', '=', 'auto')]}"
                            />
                            <field name="rate" readonly="1" />
                        </group>
                    </group>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
